# Sumber data timbangan IoT.
# 'mock' = simulasi (default, dipakai selama perangkat fisik belum dipilih).
# Nanti tambahkan implementasi baru di src/services/weighing-device.ts,
# lalu ganti nilai ini — mis. 'mqtt' | 'websocket' | 'rest'.
VITE_SCALE_TRANSPORT=mock

# Penyedia deteksi kualitas/spesies ikan.
# 'mock' = simulasi. Ganti ke 'iot-camera' setelah modul AI + kamera IoT siap.
VITE_DETECTION_PROVIDER=mock
